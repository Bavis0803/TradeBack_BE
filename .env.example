DJANGO_SECRET_KEY=replace-with-a-long-random-signing-secret
EXCHANGE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-stable-fernet-key
DEBUG=False
ALLOWED_HOSTS=tradeback.example.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://tradeback.example.com
CSRF_TRUSTED_ORIGINS=https://tradeback.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO

DB_ENGINE=postgresql
DB_NAME=tradeback
DB_USER=tradeback
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0

# This is the global production kill-switch. Individual streams still require
# explicit LIVE confirmation and continue through all risk checks.
COPY_TRADING_LIVE_ENABLED=True
COPY_TRADING_MAX_ALLOCATION_USDT=1000
COPY_TRADING_MEDIA_MAX_BYTES=10485760
COPY_TRADING_SIGNAL_MAX_AGE_SECONDS=300
